# ──────────────────────────────────────────────────────────────────────────
# Klucze API właściciela (licencja właściciela).
# Wpisz tylko te, których używasz wg wybranego profilu dostawcy.
# ──────────────────────────────────────────────────────────────────────────

# Tryb PREMIUM: mózg = Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Tryb BAZOWY: OpenAI Realtime (1 klucz) ORAZ STT (Whisper) w trybie premium
OPENAI_API_KEY=sk-...

# Tryb PREMIUM: głos = ElevenLabs
ELEVENLABS_API_KEY=...

# (opcjonalnie) Gemini Live
GEMINI_API_KEY=

# ──────────────────────────────────────────────────────────────────────────
# Domyślne ustawienia
# ──────────────────────────────────────────────────────────────────────────

# Domyślny profil dostawcy: "base" (OpenAI Realtime) lub "premium" (Claude+ElevenLabs)
DEFAULT_PROVIDER_PROFILE=premium

# Model mózgu (premium). Domyślnie najlepszy; dla niskiej latencji w zabawce
# można ustawić claude-haiku-4-5 lub claude-sonnet-4-6 (świadoma decyzja).
BRAIN_MODEL=claude-opus-4-8

# Model do ekstrakcji pamięci w tle (tani/szybki)
MEMORY_MODEL=claude-haiku-4-5

# Model STT w trybie premium (OpenAI)
STT_MODEL=whisper-1

# Format audio na linii urządzenie<->backend (PCM 16-bit mono)
AUDIO_SAMPLE_RATE=16000

# Sekret do podpisywania tokenów urządzeń/użytkowników (zmień w produkcji!)
JWT_SECRET=zmien-mnie-w-produkcji

# Katalog danych (pamięć urządzeń, profile) — w produkcji użyj bazy (Postgres)
DATA_DIR=./data
